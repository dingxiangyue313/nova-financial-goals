# Copy this file to .env. Never commit real credentials.
# DeepSeek is optional. Without a key, the complete demo uses deterministic behavior.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Required for production. Use a unique random value of at least 32 bytes.
NOVA_SESSION_SECRET=
# Shared HMAC secret for authenticated external-agent requests. Use at least 32 random characters.
NOVA_EXTERNAL_AGENT_SECRET=
# Persistent SQLite path. Docker Compose mounts ./data at /app/data.
NOVA_DB_PATH=./data/nova.sqlite

# Passkey / WebAuthn relying-party settings. localhost works for local development.
NOVA_RP_ID=localhost
NOVA_ORIGIN=http://localhost:3000
PORT=3000

# Competition builds accept bundled synthetic samples only by default.
NOVA_ALLOW_STATEMENT_UPLOAD=false
# Debug controllers and event injection are disabled in production unless explicitly enabled.
NOVA_DEMO_CONTROLS=false
