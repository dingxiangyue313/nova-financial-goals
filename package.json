{
  "name": "nova-ai-banking-agent",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "npm --workspace nova-frontend run dev",
    "preview:local": "npm --workspace nova-frontend run preview:local",
    "build": "npm --workspace nova-frontend run build",
    "start": "npm --workspace nova-frontend run start",
    "lint": "npm --workspace nova-frontend run lint",
    "test": "npm run verify:banking && npm run verify:twin",
    "verify:banking": "npm --workspace nova-backend run verify:banking",
    "verify:twin": "npm --workspace nova-backend run verify:twin",
    "verify:surfaces": "npm --workspace nova-backend run verify:surfaces",
    "verify:stage2": "npm --workspace nova-backend run verify:stage2",
    "verify:stage3": "npm --workspace nova-backend run verify:stage3",
    "verify:stage4": "npm --workspace nova-frontend run test:e2e",
    "eval:baseline": "npm --workspace nova-backend run eval:baseline",
    "eval:phase3": "npm run build && npm --workspace nova-backend run eval:phase3",
    "db:generate": "npm --workspace nova-backend run db:generate"
  },
  "engines": { "node": ">=22.13.0" }
}
