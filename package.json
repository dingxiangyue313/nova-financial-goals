{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts src/*.test.ts",
    "test:properties": "tsx --test server/properties.test.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "eval:promptfoo": "node scripts/run-promptfoo-eval.mjs",
    "eval:agent:real": "tsx scripts/run-agent-model-eval.ts",
    "eval:agent:explanation": "tsx scripts/run-agent-explanation-eval.ts --real --retry-failed",
    "test:e2e": "playwright test",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.4.299",
    "pino": "10.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "fast-check": "4.10.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
